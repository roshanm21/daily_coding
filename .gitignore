# Ignore all text files (as requested earlier)
*.txt

# Ignore compiled executables without file extensions (Mac/Linux default outputs)
# This ignores common default output names like a.out or compiled binaries named after the file
*
!*/
!*.*

# Ignore specific executable extensions (Windows defaults)
*.exe
*.o
*.obj

# Ignore debug directories and folders generated by compilers (like VS Code or VS)
.vscode/
*.dSYM/
.DS_Store
test.cpp
